{
  "expo": {
    "name": "Knightfall",
    "slug": "knightfall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.knightfall.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "bluetooth-central"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.knightfall.app",
      "permissions": [
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera lê códigos de barras para checar sódio e laticínios.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D97706",
          "sounds": [
            "./assets/sounds/alarm.wav",
            "./assets/sounds/rest.wav"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "react-native-ble-manager",
        {
          "bluetoothAlwaysPermission": "Conectar à cinta cardíaca e à AirBike via Bluetooth.",
          "neverForLocation": true,
          "isBleRequired": false,
          "companionDeviceEnabled": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Ler VFC (variabilidade da frequência cardíaca), frequência cardíaca de repouso, sono e peso para a prontidão e as metas da dieta.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "scheme": "knightfall",
    "backgroundColor": "#0A0A0B",
    "experiments": {
      "typedRoutes": true
    }
  }
}
