FROM python:3.13-slim AS build
WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY pyproject.toml ./
COPY knightfall ./knightfall
RUN python -m venv /opt/venv && /opt/venv/bin/pip install ".[postgres,observability]"

FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:$PATH"
COPY --from=build /opt/venv /opt/venv
COPY alembic.ini ./
# The API never needs root: run as an unprivileged user that owns nothing in the image.
RUN useradd --system --uid 10001 --no-create-home knightfall && mkdir /data && chown knightfall /data
USER knightfall
# SQLite fallback when no Postgres URL is given (docker-compose sets one).
ENV KNIGHTFALL_DATABASE_URL=sqlite:////data/knightfall.db
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status != 200)"]
# Migrations run on startup (Database.migrate in the app lifespan).
CMD ["uvicorn", "knightfall.api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
